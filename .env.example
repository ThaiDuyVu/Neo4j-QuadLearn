NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
APP_ENV=development

# Cấu hình domain Vũ; mặc định theo giả định SRS, có thể thay đổi local.
VU_SESSION_DAYS=7
VU_UNLOCK_COMPLETION=70
VU_UNLOCK_SCORE=6
VU_AVERAGE_POLICY=all
VU_ALLOW_SKIP=true

# Tùy chọn: mật khẩu khác cho tài khoản fixture khi tạo/reset (mặc định public Demo123456789).
# QUADLEARN_DEMO_PASSWORD=
